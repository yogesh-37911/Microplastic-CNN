# Microplastic Vision – Backend Environment Configuration
# Copy this file to .env and adjust values as needed.

# Application
APP_NAME=Microplastic Vision
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/microplastic_vision.db

# Supabase (use a PostgreSQL connection URI; the app applies asyncpg + TLS).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=analysis-images

# Storage paths (relative to backend root)
UPLOAD_DIR=data/uploads
DATASET_DIR=data/datasets
MODEL_DIR=data/models
CHECKPOINT_DIR=data/checkpoints

# Upload limits
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=jpg,jpeg,png,tiff,tif,bmp

# ML defaults
DEFAULT_IMAGE_SIZE=224
DEFAULT_BATCH_SIZE=16
DEFAULT_EPOCHS=25
DEFAULT_LEARNING_RATE=0.001
CONFIDENCE_THRESHOLD=0.5

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Demo mode – set to true when no trained model is available
DEMO_MODE=true

# Optional YOLO
YOLO_ENABLED=false
YOLO_WEIGHTS_PATH=
